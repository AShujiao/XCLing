<Application x:Class="XCLing.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:XCLing.Wpf.Core"
             xmlns:vm="clr-namespace:XCLing.Wpf.ViewModels"
             xmlns:views="clr-namespace:XCLing.Wpf.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 顺序很重要：第 0 位是主题字典（Dark/Light），第 1 位是共享样式。 -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Shared.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <core:StringToVisibilityConverter x:Key="StringToVis"/>
            <core:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <core:InverseBoolConverter x:Key="InverseBool"/>
            <core:TimeConverter x:Key="Time"/>

            <!-- 视图模型 → 视图 映射 -->
            <DataTemplate DataType="{x:Type vm:ConsoleViewModel}"><views:ConsoleView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RulesViewModel}"><views:RulesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BlocklistViewModel}"><views:BlocklistView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
