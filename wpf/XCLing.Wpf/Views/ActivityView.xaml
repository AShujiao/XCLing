<UserControl x:Class="XCLing.Wpf.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PgFontFamily}">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="运行记录" Style="{DynamicResource PgPageTitle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource PgCaption}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="刷新" Command="{Binding RefreshCommand}" Padding="14,8" VerticalAlignment="Top"/>
        </Grid>

        <Border Background="{DynamicResource DangerHoverBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding Error, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- Tab 切换 -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" 
                    BorderThickness="0" Background="Transparent" Margin="0,0,0,14">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border0Brush}" 
                                        BorderThickness="0,0,0,2" Padding="16,8" Margin="0,0,16,0" Cursor="Hand">
                                    <ContentPresenter x:Name="Content" ContentSource="Header" TextBlock.Foreground="{DynamicResource Text2Brush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Content" Property="TextBlock.FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{DynamicResource Text1Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="拦截记录"/>
            <TabItem Header="策略操作记录"/>
        </TabControl>

        <!-- 拦截记录 Tab -->
        <Border Style="{DynamicResource PgCard}" Visibility="{Binding ShowInterceptionTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button Command="{Binding EnableAuditCommand}" DockPanel.Dock="Right"
                            Content="启用日志"
                            Visibility="{Binding ShowEnableAudit, Converter={StaticResource BoolToVis}}"
                            Margin="8,0,0,0" Padding="14,4"/>
                    <TextBlock Text="最近 24 小时 SRP 拦截事件" Style="{DynamicResource PgCardTitle}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 审核未启用提示 -->
                <Border CornerRadius="6" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding ShowEnableAudit, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <SolidColorBrush Color="#FFF7DC6F" Opacity="0.2"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="ℹ️  事件日志未启用" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="SRP拦截事件记录在Windows应用程序日志中，当前日志被禁用。点击右上角「启用日志」按钮自动启用。启用后，后续拦截的程序将记录在这里。"
                                   Style="{DynamicResource PgCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="1,1,1,1" BorderBrush="{DynamicResource Border0Brush}"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Surface3Brush}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          SelectedItem="{Binding SelectedEvent}"
                          RowHeight="36" ColumnHeaderHeight="38"
                          Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}"
                          Style="{DynamicResource PgDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Timestamp, Converter={StaticResource Time}}" Header="时间" Width="170"/>
                        <DataGridTextColumn Binding="{Binding User}" Header="用户" Width="120"/>
                        <DataGridTextColumn Binding="{Binding ExecutablePath}" Header="被拦截程序" Width="*" MinWidth="220"/>
                        <DataGridTextColumn Binding="{Binding Message}" Header="说明" Width="160"/>
                        <DataGridTemplateColumn Header="操作" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="解除限制" 
                                            Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource PgButton}"
                                            Padding="10,3"
                                            FontSize="12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- 空状态提示 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,30"
                            Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="✓" FontSize="40" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="暂无拦截记录" Foreground="{DynamicResource Text1Brush}" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock Text="软件限制策略运行正常，最近24小时没有拦截任何程序" 
                               Style="{DynamicResource PgCaption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 策略操作记录 Tab -->
        <Border Style="{DynamicResource PgCard}" Visibility="{Binding ShowOperationTab, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="策略操作记录" Style="{DynamicResource PgCardTitle}" Margin="0,0,0,14"/>
                <DataGrid ItemsSource="{Binding Operations}" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="1,1,1,1" BorderBrush="{DynamicResource Border0Brush}"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Surface3Brush}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="36" ColumnHeaderHeight="38"
                          Visibility="{Binding HasOperations, Converter={StaticResource BoolToVis}}"
                          Style="{DynamicResource PgDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding CreatedAt, Converter={StaticResource Time}}" Header="时间" Width="170"/>
                        <DataGridTextColumn Binding="{Binding ActionLabel}" Header="操作" Width="150"/>
                        <DataGridTextColumn Binding="{Binding Message}" Header="结果" Width="*" MinWidth="280"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- 操作记录空状态 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,20"
                            Visibility="{Binding HasOperations, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="暂无操作记录" Foreground="{DynamicResource Text2Brush}" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
