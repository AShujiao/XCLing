<Window x:Class="XCLing.Wpf.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Surface1Brush}"
        FontFamily="{StaticResource PgFontFamily}">
    <StackPanel Margin="26,22,26,20">
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource Text0Brush}"
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource Text1Brush}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{DynamicResource PgButton}" Content="取消"
                    MinWidth="84" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Style="{DynamicResource PgPrimaryButton}"
                    MinWidth="104" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
