<UserControl x:Class="XCLing.Wpf.Views.ConsoleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource PgFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="概览" Style="{StaticResource PgPageTitleCompact}" />
                    <TextBlock Text="查看保护状态、策略范围和最近操作" Style="{StaticResource PgCaption}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{StaticResource RefreshIcon}" Command="{Binding RefreshCommand}" Style="{StaticResource PgIconButton}" ToolTip="刷新状态" AutomationProperties.Name="刷新状态" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource PgList}" Visibility="{Binding ShowModeSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource PgListHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启用保护模式" Style="{StaticResource PgCardTitle}" />
                                <TextBlock Text="选择适合当前设备的放行策略" Style="{StaticResource PgCaption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="尚未启用" Style="{StaticResource PgCaption}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PgListRow}" BorderThickness="0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="保护模式" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedModeDescription}" Style="{StaticResource PgCaption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="ProtectionMode" Style="{StaticResource PgSegment}" Content="白名单模式" IsChecked="{Binding WhitelistSelected}" IsEnabled="{Binding CanEnableMode}" Margin="0,0,8,0" />
                                <RadioButton GroupName="ProtectionMode" Style="{StaticResource PgSegment}" Content="黑名单模式" IsChecked="{Binding BlacklistSelected}" IsEnabled="{Binding CanEnableMode}" Margin="0,0,8,0" />
                                <Button Content="{Binding EnableSelectedText}" Command="{Binding EnableSelectedCommand}" Style="{StaticResource PgPrimaryButton}" IsEnabled="{Binding CanEnableMode}" MinWidth="126" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PgList}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" Padding="16,14" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="当前保护状态" Style="{StaticResource PgCaption}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Text2Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="locked"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="unlocked"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="attention"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="unavailable"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StateLabel}" FontSize="20" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="locked"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="unlocked"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="attention"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="unavailable"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding StateDescription}" Style="{StaticResource PgCaption}" Margin="0,4,0,0" MaxHeight="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateDescription}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PgPrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding PrimaryEnabled}" Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" MinWidth="126" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="14,0,14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="2,11,12,12" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,1,0">
                            <StackPanel><TextBlock Text="当前模式" Style="{StaticResource PgCaption}" /><TextBlock Text="{Binding ModeLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModeLabel}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="12,11" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,1,0">
                            <StackPanel><TextBlock Text="策略规则" Style="{StaticResource PgCaption}" /><TextBlock Text="{Binding RuleCountText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="12,11" BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,1,0">
                            <StackPanel><TextBlock Text="接管前备份" Style="{StaticResource PgCaption}" /><TextBlock Text="{Binding BackupText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupText}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="12,11,2,12">
                            <StackPanel><TextBlock Text="策略来源" Style="{StaticResource PgCaption}" /><TextBlock Text="{Binding SourceText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" /><TextBlock Text="{Binding AdminText}" Style="{StaticResource PgCaption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource PgCallout}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningHoverBrush}" Visibility="{Binding ShellRefreshPending, Converter={StaticResource BoolToVis}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="资源管理器尚未加载最新策略，双击启动的程序可能不会被拦截。" Style="{StaticResource PgCaption}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="重启资源管理器" Command="{Binding RefreshShellCommand}" Style="{StaticResource PgButton}" ToolTip="重启后新策略对双击启动的程序立即生效" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PgCallout}" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerHoverBrush}" Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource PgList}">
                <StackPanel>
                    <Border Style="{StaticResource PgListHeader}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="最近操作" Style="{StaticResource PgCardTitle}" />
                            <Button Grid.Column="1" Content="查看全部记录" Command="{Binding ShowOperationsCommand}" Style="{StaticResource PgLinkButton}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding RecentError}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="14,10" Visibility="{Binding RecentError, Converter={StaticResource StringToVis}}" />
                    <ItemsControl ItemsSource="{Binding RecentOperations}">
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter" BasedOn="{StaticResource PgAnimatedItem}" /></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PgListRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource Time}}" Style="{StaticResource PgCaption}" Width="140" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="Text" Value="操作失败" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="Text" Value="操作成功" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="暂无操作记录" Style="{StaticResource PgEmptyState}" Visibility="{Binding ShowEmptyRecent, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PgList}" Background="{DynamicResource Surface2Brush}">
                <Grid Margin="14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="模式设置与恢复" Style="{StaticResource PgCardTitle}" /><TextBlock Text="切换模式或卸载前，请先恢复接管前策略。" Style="{StaticResource PgCaption}" Margin="0,3,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="恢复接管前策略" Style="{StaticResource PgDangerButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
