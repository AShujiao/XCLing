<UserControl x:Class="XCLing.Wpf.Views.ConsoleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource PgFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="保护概览" Style="{StaticResource PgPageTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource PgIconButton}" Content="{StaticResource RefreshIcon}" ToolTip="刷新策略状态" AutomationProperties.Name="刷新策略状态" Command="{Binding RefreshCommand}" />
            </Grid>
            <Border Background="{DynamicResource DangerHoverBrush}" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource WarningHoverBrush}" Padding="12" Margin="0,0,0,12" Visibility="{Binding ShellRefreshPending, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="资源管理器尚未加载最新策略，双击启动的程序可能不会被拦截。" Style="{StaticResource PgCaption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="重启资源管理器" Command="{Binding RefreshShellCommand}" Style="{StaticResource PgButton}" ToolTip="重启后新策略对双击启动的程序立即生效" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PgCard}" Padding="0,8,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding StateLabel}" FontSize="26" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="locked">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="unlocked">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="attention">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StateDescription}" Style="{StaticResource PgCaption}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PgPrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding PrimaryEnabled}" Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" MinWidth="116" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PgCard}" Visibility="{Binding ShowModeSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="保护模式" Style="{StaticResource PgCardTitle}" />
            </Border>
            <StackPanel Visibility="{Binding ShowModeSelection, Converter={StaticResource BoolToVis}}" Margin="0,-12,0,20">
                <WrapPanel>
                    <RadioButton GroupName="ProtectionMode" Style="{StaticResource PgSegment}" Content="白名单模式" IsChecked="{Binding WhitelistSelected}" IsEnabled="{Binding CanEnableMode}" Margin="0,0,8,8" />
                    <RadioButton GroupName="ProtectionMode" Style="{StaticResource PgSegment}" Content="黑名单模式" IsChecked="{Binding BlacklistSelected}" IsEnabled="{Binding CanEnableMode}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="{Binding SelectedModeDescription}" Style="{StaticResource PgCaption}" Margin="0,0,0,12" />
                <Button Content="{Binding EnableSelectedText}" Command="{Binding EnableSelectedCommand}" Style="{StaticResource PgPrimaryButton}" HorizontalAlignment="Left" />
            </StackPanel>
            <Border Style="{StaticResource PgCard}">
                <WrapPanel>
                    <StackPanel Width="150" Margin="0,0,12,6">
                        <TextBlock Text="当前模式" Style="{StaticResource PgCaption}" />
                        <TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,6">
                        <TextBlock Text="策略规则" Style="{StaticResource PgCaption}" />
                        <TextBlock Text="{Binding RuleCountText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,6">
                        <TextBlock Text="接管前备份" Style="{StaticResource PgCaption}" />
                        <TextBlock Text="{Binding BackupText}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,0,6">
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource PgCaption}" />
                        <TextBlock Text="{Binding AdminText}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
            </Border>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="最近操作" Style="{StaticResource PgCardTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="查看全部记录" Command="{Binding ShowOperationsCommand}" Style="{StaticResource PgLinkButton}" />
            </Grid>
            <TextBlock Text="{Binding RecentError}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="{Binding RecentError, Converter={StaticResource StringToVis}}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding RecentOperations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="10,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource Time}}" Style="{StaticResource PgCaption}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Margin="8,0" />
                                <TextBlock Grid.Column="2" ToolTip="{Binding Message}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="操作失败" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                    <Setter Property="Text" Value="操作成功" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="暂无操作记录" Style="{StaticResource PgCaption}" Margin="10,20" Visibility="{Binding ShowEmptyRecent, Converter={StaticResource BoolToVis}}" />
            <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="模式设置与恢复" Style="{StaticResource PgCardTitle}" />
                        <TextBlock Text="切换模式或卸载前，请先恢复接管前策略。" Style="{StaticResource PgCaption}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="恢复接管前策略" Style="{StaticResource PgDangerButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
