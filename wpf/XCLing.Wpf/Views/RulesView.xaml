<UserControl x:Class="XCLing.Wpf.Views.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource PgFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="白名单" Style="{StaticResource PgPageTitle}" />
                <TextBlock Text="{Binding HeaderHint}" Style="{StaticResource PgCaption}" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Style="{StaticResource PgCaption}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Style="{StaticResource PgComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding NewKind}" AutomationProperties.Name="信任路径类型">
                <ComboBoxItem Content="目录" Tag="directory" />
                <ComboBoxItem Content="单个程序" Tag="file" />
            </ComboBox>
            <TextBox Grid.Column="1" Style="{StaticResource PgTextBox}" Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" AutomationProperties.Name="信任路径" ToolTip="{Binding NewPath}" />
            <Button Grid.Column="2" Style="{StaticResource PgIconButton}" Content="{StaticResource FolderIcon}" Command="{Binding BrowseCommand}" ToolTip="浏览路径" AutomationProperties.Name="浏览路径" Margin="0,0,8,0" />
            <Button Grid.Column="3" Style="{StaticResource PgPrimaryButton}" Content="{Binding AddButtonText}" Command="{Binding AddPathCommand}" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource DangerHoverBrush}" Padding="12,10" Margin="0,0,0,14" Visibility="{Binding Error, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{DynamicResource WarningHoverBrush}" Padding="12" Margin="0,0,0,16" Visibility="{Binding ShowModeGuidance, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GuidanceText}" Style="{StaticResource PgCaption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="前往概览" Style="{StaticResource PgButton}" Command="{Binding GoConsoleCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="自定义规则" Style="{StaticResource PgCardTitle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ActiveExtraRules}" Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource PgPath}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource PgCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PgIconButton}" Content="{StaticResource CloseIcon}" ToolTip="删除信任规则" AutomationProperties.Name="删除信任规则" Command="{Binding DataContext.RemoveActiveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <TextBlock Text="暂无自定义规则" Style="{StaticResource PgCaption}" Margin="8,16" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding PendingPaths}" Visibility="{Binding Active, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource PgPath}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Style="{StaticResource PgCaption}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource PgIconButton}" Content="{StaticResource CloseIcon}" ToolTip="删除待启用规则" AutomationProperties.Name="删除待启用规则" Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <TextBlock Text="暂无待启用规则" Style="{StaticResource PgCaption}" Margin="8,16" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <Border Style="{StaticResource PgCard}" Margin="0,20,0,20">
                    <Expander Header="默认信任目录" Foreground="{DynamicResource Text1Brush}">
                        <StackPanel Margin="10,12,0,0">
                            <TextBlock Text="Windows 系统目录" Style="{StaticResource PgCaption}" />
                            <TextBlock Text="C:\Windows\*" Style="{StaticResource PgPath}" Margin="0,3,0,10" />
                            <TextBlock Text="标准安装目录" Style="{StaticResource PgCaption}" />
                            <TextBlock Text="C:\Program Files\*" Style="{StaticResource PgPath}" Margin="0,3,0,10" />
                            <TextBlock Text="C:\Program Files (x86)\*" Style="{StaticResource PgPath}" />
                        </StackPanel>
                    </Expander>
                </Border>
                <Button Content="从已安装程序导入" Command="{Binding ToggleScannerCommand}" Style="{StaticResource PgButton}" HorizontalAlignment="Left" />
                <StackPanel Visibility="{Binding ShowScanner, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PgTextBox}" AutomationProperties.Name="搜索已安装程序" />
                        <Button Grid.Column="1" Content="扫描" Command="{Binding ScanCommand}" Style="{StaticResource PgButton}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="正在扫描..." Style="{StaticResource PgCaption}" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding FilteredApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding CandidatePath}" Style="{StaticResource PgPath}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="放行" Style="{StaticResource PgButton}" IsEnabled="{Binding Selectable}" Command="{Binding DataContext.ApplyDiscoveredCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
