<UserControl x:Class="XCLing.Wpf.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PgFontFamily}">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="白名单" Style="{DynamicResource PgPageTitle}"/>
                <TextBlock Text="{Binding HeaderHint}" Style="{DynamicResource PgCaption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Top">
                <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource Text1Brush}" FontSize="12"/>
            </Border>
        </Grid>

        <Border Background="{DynamicResource DangerHoverBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding Error, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- 白名单模式未运行时引导先去主控制台开启 -->
        <Border Background="{DynamicResource WarningHoverBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14"
                Visibility="{Binding ShowModeGuidance, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="⚠️  白名单模式未开启" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding GuidanceText}" Foreground="{DynamicResource Text1Brush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="前往主控制台"
                        Command="{Binding GoConsoleCommand}" Padding="14,8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 默认白名单目录 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="默认白名单目录" Style="{DynamicResource PgCardTitle}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Windows 系统目录" Foreground="{DynamicResource Text1Brush}" Width="170"/><TextBlock Text="C:\Windows\*" Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="标准安装目录" Foreground="{DynamicResource Text1Brush}" Width="170"/><TextBlock Text="C:\Program Files\*" Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"/></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="32 位安装目录" Foreground="{DynamicResource Text1Brush}" Width="170"/><TextBlock Text="C:\Program Files (x86)\*" Foreground="{DynamicResource Text2Brush}" FontFamily="Consolas"/></StackPanel>
            </StackPanel>
        </Border>

        <!-- 自定义白名单 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="自定义白名单" Style="{DynamicResource PgCardTitle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{DynamicResource PgComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding NewKind}">
                        <ComboBoxItem Content="目录" Tag="directory" IsSelected="True"/>
                        <ComboBoxItem Content="单个程序" Tag="file"/>
                    </ComboBox>
                    <TextBox Grid.Column="1" Style="{DynamicResource PgTextBox}" Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                    <Button Grid.Column="2" Style="{DynamicResource PgButton}" Content="浏览" Command="{Binding BrowseCommand}" Padding="12,7" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" Style="{DynamicResource PgPrimaryButton}" Content="{Binding AddButtonText}" Command="{Binding AddPathCommand}" Padding="16,7"/>
                </Grid>

                <!-- 启用后：可即时删除的规则 -->
                <ItemsControl ItemsSource="{Binding ActiveExtraRules}" Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Text1Brush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{DynamicResource PgCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="删除" Padding="14,6" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveActiveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 未启用：待启用规则 -->
                <ItemsControl ItemsSource="{Binding PendingPaths}" Visibility="{Binding Active, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Path}" Foreground="{DynamicResource Text1Brush}" FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{DynamicResource Text3Brush}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Grid.Column="2" Style="{DynamicResource PgButton}" Content="删除" Padding="14,6"
                                            Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 从已安装程序导入 -->
        <Border Style="{DynamicResource PgCard}">
            <StackPanel>
                <Button Style="{DynamicResource PgButton}" Content="从已安装程序导入" Command="{Binding ToggleScannerCommand}" HorizontalAlignment="Left" Padding="14,8"/>
                <StackPanel Visibility="{Binding ShowScanner, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource PgTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="扫描" Command="{Binding ScanCommand}" Margin="8,0,0,0" Padding="14,7"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FilteredApps}" MaxHeight="340">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{DynamicResource PgButton}" Content="放行" Padding="12,5" VerticalAlignment="Center" IsEnabled="{Binding Selectable}"
                                                Command="{Binding DataContext.ApplyDiscoveredCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text0Brush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CandidatePath}" Foreground="{DynamicResource Text3Brush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
