<UserControl x:Class="XCLing.Wpf.Views.BlocklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PgFontFamily}">
    <StackPanel>
        <!-- 页头 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="黑名单" Style="{DynamicResource PgPageTitle}"/>
                <TextBlock Text="{Binding StatusText, Mode=OneWay}" Style="{DynamicResource PgCaption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="刷新" Command="{Binding RefreshCommand}" Padding="14,8" VerticalAlignment="Top"/>
        </Grid>

        <!-- 错误提示 -->
        <Border Background="{DynamicResource DangerHoverBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding Error, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- 保护未启用时引导先去主控制台开启黑名单模式 -->
        <Border Background="{DynamicResource WarningHoverBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14"
                Visibility="{Binding ShowNotEnabledWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="⚠️  黑名单模式未开启" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="黑名单规则需在保护启用后才能添加和生效。请前往「主控制台」启用黑名单模式；启用后可随时增删规则，即时生效，无需重启系统。"
                               Foreground="{DynamicResource Text1Brush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="前往主控制台"
                        Command="{Binding GoConsoleCommand}" Padding="14,8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 厂商预设 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="预设黑名单包" Style="{DynamicResource PgCardTitle}" Margin="0,0,0,4"/>
                <TextBlock Text="一键拦截常见流氓软件厂商的全部程序" Style="{DynamicResource PgCaption}" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding Vendors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Padding="14,12"
                                    Margin="0,0,10,10" Width="220">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text0Brush}"
                                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Description}" Style="{DynamicResource PgCaption}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{DynamicResource PgPrimaryButton}" Content="拦截"
                                                Padding="14,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ApplyVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Applied, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                        <Button Style="{DynamicResource PgButton}" Content="已拦截 · 移除"
                                                Padding="14,6"
                                                Command="{Binding DataContext.RemoveVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Applied, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 扫描本机已安装软件 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="扫描本机安装软件" Style="{DynamicResource PgCardTitle}"/>
                        <TextBlock Text="检测已安装的流氓软件，按需一键拦截" Style="{DynamicResource PgCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="开始扫描"
                            Command="{Binding ScanCommand}" Padding="14,8" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel Visibility="{Binding HasScanResults, Mode=OneWay, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding ScanResults}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6"
                                        Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource PgPrimaryButton}" Content="拦截"
                                                    Padding="12,5"
                                                    Command="{Binding DataContext.ApplyScanItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                            <Button Style="{DynamicResource PgButton}" Content="已拦截"
                                                    Padding="12,5" IsEnabled="False"
                                                    Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text0Brush}"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding Suggested, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="建议拦截" Foreground="White" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Publisher}" Style="{DynamicResource PgCaption}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding InstallPath}" Foreground="{DynamicResource Text3Brush}"
                                                       FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 手动添加规则 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="手动添加黑名单规则" Style="{DynamicResource PgCardTitle}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{DynamicResource PgComboBox}"
                              SelectedValuePath="Tag" SelectedValue="{Binding NewKind}">
                        <ComboBoxItem Content="程序名" Tag="filename" IsSelected="True"/>
                        <ComboBoxItem Content="目录" Tag="directory"/>
                        <ComboBoxItem Content="精确路径" Tag="file"/>
                    </ComboBox>
                    <TextBox Grid.Column="1" Style="{DynamicResource PgTextBox}"
                             Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,0" FontFamily="Consolas"/>
                    <Button Grid.Column="2" Style="{DynamicResource PgPrimaryButton}" Content="添加"
                            Command="{Binding AddRuleCommand}" Padding="16,7"/>
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{DynamicResource PgCaption}" TextWrapping="Wrap">
                    程序名：仅填写 exe 文件名（如 360safe.exe），匹配所有目录；目录：以 \* 结尾的路径；精确路径：完整可执行文件路径
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 当前拦截规则列表 -->
        <Border Style="{DynamicResource PgCard}" Visibility="{Binding HasRules, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="当前黑名单规则" Style="{DynamicResource PgCardTitle}"/>
                    <TextBlock Text=" (" Foreground="{DynamicResource Text3Brush}" FontSize="12" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding RuleCount, Mode=OneWay}" Foreground="{DynamicResource Text3Brush}" FontSize="12"/>
                    <TextBlock Text="条)" Foreground="{DynamicResource Text3Brush}" FontSize="12"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6"
                                    Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Pattern}" Foreground="{DynamicResource Text1Brush}"
                                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Kind}" Style="{DynamicResource PgCaption}"/>
                                            <TextBlock Text=" · " Style="{DynamicResource PgCaption}"
                                                       Visibility="{Binding Label, Converter={StaticResource StringToVis}}"/>
                                            <TextBlock Text="{Binding Label}" Style="{DynamicResource PgCaption}"
                                                       Visibility="{Binding Label, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerHoverBrush}"
                                            CornerRadius="3" Padding="6,2" Margin="10,0,10,0" VerticalAlignment="Center"
                                            Visibility="{Binding Preset, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="预设" Foreground="{DynamicResource DangerBrush}" FontSize="11"/>
                                    </Border>
                                    <Button Grid.Column="2" Style="{DynamicResource PgButton}" Content="删除"
                                            Padding="14,6" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
