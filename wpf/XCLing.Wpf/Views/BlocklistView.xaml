<UserControl x:Class="XCLing.Wpf.Views.BlocklistView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource PgFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="黑名单" Style="{StaticResource PgPageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PgCaption}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{StaticResource RefreshIcon}" Command="{Binding RefreshCommand}" Style="{StaticResource PgIconButton}" ToolTip="刷新黑名单" AutomationProperties.Name="刷新黑名单" VerticalAlignment="Top" />
        </Grid>
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource DangerHoverBrush}" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding Error, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
            </Border>
            <Border Background="{DynamicResource WarningHoverBrush}" Padding="12" Margin="0,0,0,16" Visibility="{Binding ShowNotEnabledWarning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保护尚未启用，黑名单规则暂不可用。" Style="{StaticResource PgCaption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="前往概览" Command="{Binding GoConsoleCommand}" Style="{StaticResource PgButton}" />
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <!-- 一、厂商预设。批量来源统一排在拦截清单之前：应用预设后清单在其下方增长，已读内容不会被顶走。 -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="厂商预设" Style="{StaticResource PgCardTitle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Vendors.Count, StringFormat={}共 {0} 组}" Style="{StaticResource PgCaption}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="整组添加或移除常见捆绑软件的拦截规则；应用后规则会加入下方的「当前拦截规则」。" Style="{StaticResource PgCaption}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Vendors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource PgCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{Binding Description}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="拦截" Style="{StaticResource PgButton}" Padding="12,4" MinHeight="28" Command="{Binding DataContext.ApplyVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="添加该厂商的全部拦截规则" Visibility="{Binding Applied, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <Button Content="移除预设" Style="{StaticResource PgButton}" Padding="12,4" MinHeight="28" Command="{Binding DataContext.RemoveVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="移除该厂商的全部拦截规则" Visibility="{Binding Applied, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 二、本机软件扫描。同属批量来源，结果区限高滚动，避免扫描后把下方清单推得很远。 -->
                <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,22,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="本机软件扫描" Style="{StaticResource PgCardTitle}" />
                                <TextBlock Text="扫描已安装的软件并选择要拦截的目标；结果同样加入下方的拦截清单。" Style="{StaticResource PgCaption}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource PgButton}" VerticalAlignment="Top" />
                        </Grid>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ScanResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource PgCaption}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding InstallPath}" Style="{StaticResource PgPath}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Content="拦截" Style="{StaticResource PgButton}" Padding="12,4" MinHeight="28" Command="{Binding DataContext.ApplyScanItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                    <TextBlock Text="已拦截" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <!-- 三、当前拦截清单。手动添加工具栏与清单贴在一起，添加后立刻在下方看到结果。 -->
                <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="0,18,0,22" Margin="0,22,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="当前拦截规则" Style="{StaticResource PgCardTitle}" />
                            <TextBlock Text="{Binding RuleCount, StringFormat={}  {0} 条}" Style="{StaticResource PgCaption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="规则即时生效，只拦新启动的程序；已经在运行的程序需要退出后重新打开。" Style="{StaticResource PgCaption}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource PgComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding NewKind}" AutomationProperties.Name="拦截规则类型">
                                <ComboBoxItem Content="程序名" Tag="filename" />
                                <ComboBoxItem Content="目录" Tag="directory" />
                                <ComboBoxItem Content="精确路径" Tag="file" />
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PgTextBox}" Margin="8,0" AutomationProperties.Name="拦截程序或路径" ToolTip="{Binding NewPattern}" />
                            <Button Grid.Column="2" Content="添加" Command="{Binding AddRuleCommand}" Style="{StaticResource PgPrimaryButton}" />
                        </Grid>
                        <TextBlock Text="程序名只填 exe 文件名（如 360safe.exe），匹配所有目录下的同名程序；目录需以 \* 结尾；精确路径填写完整可执行文件路径。" Style="{StaticResource PgCaption}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Pattern}" Style="{StaticResource PgPath}" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource PgCaption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="预设" Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding Preset, Converter={StaticResource BoolToVis}}" />
                                            <Button Grid.Column="2" Content="{StaticResource CloseIcon}" Style="{StaticResource PgIconButton}" ToolTip="删除拦截规则" AutomationProperties.Name="删除拦截规则" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无拦截规则" Style="{StaticResource PgCaption}" Margin="8,18" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
