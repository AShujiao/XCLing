<UserControl x:Class="XCLing.Wpf.Views.BlocklistView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource PgFontFamily}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="黑名单" Style="{StaticResource PgPageTitleCompact}" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource PgCaption}" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Content="{StaticResource RefreshIcon}" Command="{Binding RefreshCommand}" Style="{StaticResource PgIconButton}" ToolTip="刷新黑名单" AutomationProperties.Name="刷新黑名单" VerticalAlignment="Center" /></Grid>
        <StackPanel Grid.Row="1"><Border Style="{StaticResource PgCallout}" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerHoverBrush}" Visibility="{Binding Error, Converter={StaticResource StringToVis}}"><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" /></Border><Border Style="{StaticResource PgCallout}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningHoverBrush}" Visibility="{Binding ShowNotEnabledWarning, Converter={StaticResource BoolToVis}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="保护尚未启用，黑名单规则暂不可用。" Style="{StaticResource PgCaption}" Margin="0,0,14,0" VerticalAlignment="Center" /><Button Grid.Column="1" Content="前往概览" Command="{Binding GoConsoleCommand}" Style="{StaticResource PgButton}" /></Grid></Border></StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
            <TextBlock Text="厂商预设" Style="{StaticResource PgSectionLabel}" />
            <Border Style="{StaticResource PgList}">
                <StackPanel>
                    <Border Style="{StaticResource PgListHeader}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="常见软件包" Style="{StaticResource PgCardTitle}" /><TextBlock Grid.Column="1" Text="{Binding Vendors.Count, StringFormat={}共 {0} 组}" Style="{StaticResource PgCaption}" /></Grid></Border>
                    <ItemsControl ItemsSource="{Binding Vendors}"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter" BasedOn="{StaticResource PgAnimatedItem}" /></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PgListRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Description}" Style="{StaticResource PgCaption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0" ToolTip="{Binding Description}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="拦截" Style="{StaticResource PgButton}" Padding="12,5" MinHeight="30" Command="{Binding DataContext.ApplyVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Visibility="{Binding Applied, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" /><Button Content="移除预设" Style="{StaticResource PgButton}" Padding="12,5" MinHeight="30" Command="{Binding DataContext.RemoveVendorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Visibility="{Binding Applied, Converter={StaticResource BoolToVis}}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="本机软件扫描" Style="{StaticResource PgSectionLabel}" />
            <Border Style="{StaticResource PgList}">
                <StackPanel>
                    <Border Style="{StaticResource PgListHeader}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="扫描安装的软件" Style="{StaticResource PgCardTitle}" /><TextBlock Text="扫描已安装的软件并选择要拦截的目标。" Style="{StaticResource PgCaption}" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource PgButton}" /></Grid></Border>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}"><ItemsControl ItemsSource="{Binding ScanResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PgListRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding Publisher}" Style="{StaticResource PgCaption}" Margin="0,3,0,0" /><TextBlock Text="{Binding InstallPath}" Style="{StaticResource PgPath}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="拦截" Style="{StaticResource PgButton}" Padding="12,5" MinHeight="30" Command="{Binding DataContext.ApplyScanItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" /><TextBlock Text="已拦截" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding AlreadyBlocked, Converter={StaticResource BoolToVis}}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </StackPanel>
            </Border>
            <TextBlock Text="当前拦截规则" Style="{StaticResource PgSectionLabel}" />
            <Border Style="{StaticResource PgList}">
                <StackPanel>
                    <Border Style="{StaticResource PgListHeader}"><StackPanel><DockPanel><TextBlock Text="正在生效的规则" Style="{StaticResource PgCardTitle}" /><TextBlock Text="{Binding RuleCount, StringFormat={}  {0} 条}" Style="{StaticResource PgCaption}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="规则即时生效，只拦新启动的程序；已运行程序需退出后重新打开。" Style="{StaticResource PgCaption}" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,0,1" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Style="{StaticResource PgComboBox}" Width="96" SelectedValuePath="Tag" SelectedValue="{Binding NewKind}" AutomationProperties.Name="拦截规则类型"><ComboBoxItem Content="程序名" Tag="filename" /><ComboBoxItem Content="目录" Tag="directory" /><ComboBoxItem Content="精确路径" Tag="file" /></ComboBox><TextBox Grid.Column="1" Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PgTextBox}" Margin="10,0" MinWidth="0" AutomationProperties.Name="拦截程序或路径" ToolTip="{Binding NewPattern}" /><Button Grid.Column="2" Content="添加" Command="{Binding AddRuleCommand}" Style="{StaticResource PgPrimaryButton}" /></Grid></Border>
                    <TextBlock Text="程序名填写 exe 文件名；目录需以 \* 结尾；精确路径填写完整可执行文件路径。" Style="{StaticResource PgCaption}" Margin="14,10,14,5" />
                    <ItemsControl ItemsSource="{Binding Rules}"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter" BasedOn="{StaticResource PgAnimatedItem}" /></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PgListRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Pattern}" Style="{StaticResource PgPath}" /><TextBlock Text="{Binding Label}" Style="{StaticResource PgCaption}" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Style="{StaticResource PgStatusBadge}" Padding="8,3" Margin="0,0,10,0" Visibility="{Binding Preset, Converter={StaticResource BoolToVis}}"><TextBlock Text="预设" Foreground="{DynamicResource Text2Brush}" FontSize="11" /></Border><Button Grid.Column="2" Content="{StaticResource TrashIcon}" Style="{StaticResource PgIconButton}" ToolTip="删除拦截规则" AutomationProperties.Name="删除拦截规则" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="暂无拦截规则" Style="{StaticResource PgEmptyState}" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
