<UserControl x:Class="XCLing.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:XCLing.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="{StaticResource PgFontFamily}"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">
    <StackPanel MaxWidth="600">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="/Assets/logo.png" Width="64" Height="64" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" Style="{StaticResource PgPageTitle}"/>
                <TextBlock Text="{Binding Description}" Style="{DynamicResource PgCaption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- 版本信息 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="版本信息" Style="{DynamicResource PgCardTitle}"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="界面版本" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UiVersion}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="核心版本" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreVersion}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 检查更新 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="检查更新" Style="{DynamicResource PgCardTitle}"/>
                <TextBlock Text="通过 GitHub Releases 检查最新版本。仅在点击时联网，不上传任何数据。"
                           Style="{DynamicResource PgCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateStatus}"
                               Foreground="{DynamicResource Text1Brush}" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource PgButton}" Content="检查更新"
                                Command="{Binding CheckUpdateCommand}" MinWidth="96"
                                ToolTip="从 GitHub Releases 获取最新版本（仅点击时联网）"/>
                        <Button Style="{DynamicResource PgButton}" Content="去下载" MinWidth="96"
                                Margin="8,0,0,0" Command="{Binding OpenReleaseCommand}"
                                Visibility="{Binding CanOpenRelease, Converter={StaticResource BoolToVis}}"
                                ToolTip="打开 GitHub Release 页面下载安装包"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 联系信息 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="联系信息" Style="{DynamicResource PgCardTitle}"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="作者" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Author}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Github}" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="Underline" Cursor="Hand" Margin="0,4">
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenGithubCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="联系邮箱" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Contact}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 捐助支持 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="捐助支持" Style="{DynamicResource PgCardTitle}"/>
                    <TextBlock Text="如果这个软件帮助到了您，欢迎请作者喝一杯咖啡。"
                               Style="{DynamicResource PgCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{DynamicResource PgButton}" Content="❤ 查看收款二维码"
                        Command="{Binding DonateCommand}" VerticalAlignment="Center"
                        ToolTip="微信 / 支付宝收款二维码"/>
            </Grid>
        </Border>

        <!-- 使用须知 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="使用须知" Style="{DynamicResource PgCardTitle}"/>
                <Border Background="{DynamicResource WarningHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                    <TextBlock Text="白名单模式下，未加入白名单的软件将无法运行；黑名单模式下，黑名单中的软件将被拦截。若遇到软件功能受限，请前往「记录」查看拦截情况，可通过调整白名单/黑名单或临时解锁解除限制。&#10;卸载本软件前，请务必先在「主控制台」执行「恢复原状」还原系统原有策略后再卸载，避免系统异常。"
                               Foreground="{DynamicResource Text1Brush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 法律信息 -->
        <Border Style="{DynamicResource PgCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="法律信息" Style="{DynamicResource PgCardTitle}"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版权所有" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Copyright}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="授权协议" Style="{DynamicResource PgCaption}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License}" Foreground="{DynamicResource Text1Brush}" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
