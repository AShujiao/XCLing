<Window x:Class="XCLing.Wpf.Views.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="捐助支持"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Surface1Brush}"
        FontFamily="{StaticResource PgFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <StackPanel Margin="26,22,26,20">
        <TextBlock Text="❤ 捐助支持" Foreground="{DynamicResource Text0Brush}"
                   FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="如果这个软件帮助到了您，欢迎请作者喝一杯咖啡。&#10;请使用 微信 或 支付宝 扫描下方收款二维码。"
                   Foreground="{DynamicResource Text1Brush}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>

        <!-- 收款二维码：白底衬托，保证深色/浅色主题下都能正常扫描。 -->
        <Border Background="White" CornerRadius="10" Padding="8" Margin="0,16,0,0"
                BorderBrush="{DynamicResource Border0Brush}" BorderThickness="1">
            <Image Source="/Assets/donate.jpg" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <Button Style="{DynamicResource PgPrimaryButton}" Content="关闭"
                HorizontalAlignment="Right" MinWidth="96" Margin="0,18,0,0"
                IsCancel="True" Click="OnClose"/>
    </StackPanel>
</Window>
