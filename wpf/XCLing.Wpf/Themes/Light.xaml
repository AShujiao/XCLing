<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface0Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface1Brush" Color="#F7F9FA" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="Surface4Brush" Color="#EAF0F5" />
    <!-- 表格交替行：浅色下用极淡的蓝灰，避免与表头底色混淆。 -->
    <SolidColorBrush x:Key="AltRowBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="Text0Brush" Color="#25313A" />
    <SolidColorBrush x:Key="Text1Brush" Color="#37444E" />
    <SolidColorBrush x:Key="Text2Brush" Color="#64717C" />
    <SolidColorBrush x:Key="Text3Brush" Color="#6C7882" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E5E9" />
    <SolidColorBrush x:Key="Border0Brush" Color="#DCE3E8" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F1FE" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#226BC4" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#195AAA" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B03844" />
    <SolidColorBrush x:Key="WarningBrush" Color="#946014" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#137351" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FCEDEF" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#FFF5DF" />
</ResourceDictionary>
