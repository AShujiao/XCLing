<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色配色：低反射、高对比、护眼。 -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#FF08090A"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#FF0F1011"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#FF151719"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#FF1C1F24"/>
    <SolidColorBrush x:Key="Surface4Brush" Color="#FF262A31"/>
    <SolidColorBrush x:Key="Text0Brush" Color="#FFF7F8F8"/>
    <SolidColorBrush x:Key="Text1Brush" Color="#FFD0D6E0"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#FF8A8F98"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#FF62666D"/>
    <SolidColorBrush x:Key="Border0Brush" Color="#22FFFFFF"/>
    <!-- 深色主题卡片边框：使用更淡的透明度，深色背景下边框不明显，主要靠阴影分层 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#11FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2F80ED"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF4B92EF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF5466"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF2B84B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34D399"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#22EF5466"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#22F2B84B"/>

    <!-- 深色主题阴影：柔和扩散，营造深度感 -->
    <DropShadowEffect x:Key="PgCardShadow" Color="#40000000" BlurRadius="20" ShadowDepth="2" Opacity="0.5" Direction="270"/>
</ResourceDictionary>
