<Window x:Class="XCLing.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppName}"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0Brush}"
        FontFamily="{StaticResource PgFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,10,18">
                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource Text0Brush}"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="软件限制策略" Style="{DynamicResource PgCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding FooterText}"
                           Foreground="{DynamicResource Text3Brush}" FontSize="11" Margin="10,14,10,0"/>
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" Content="{Binding Title}"
                                    Style="{DynamicResource PgNavButton}"
                                    HorizontalAlignment="Stretch" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 内容区 + Toast -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,24">
                <ContentControl Content="{Binding CurrentPage}" MaxWidth="1020" HorizontalAlignment="Stretch"/>
            </ScrollViewer>

            <ItemsControl ItemsSource="{Binding Toasts}" VerticalAlignment="Top"
                          HorizontalAlignment="Right" Margin="0,18,22,0" IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="16,11" Margin="0,0,0,8" MaxWidth="380" BorderThickness="0,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#20000000" BlurRadius="14" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Text1Brush}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
